# Copy to .env and fill in. The anon key ships to the browser (it is public by
# design); the service-role key NEVER ships to the browser — it is only read
# server-side inside the Edge Function via `supabase secrets set`.

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase CLI / Edge Functions (shell only) ---
SUPABASE_SERVICE_ROLE_KEY=
# The alphanumeric project ref from your Supabase dashboard URL.
SUPABASE_PROJECT_REF=

# --- Playwright E2E (only read when running `pnpm test:e2e`) ---
# Serve the app first (`pnpm dev` or `pnpm build && pnpm preview`).
E2E_BASE_URL=http://localhost:4173
#
# An APPROVED NON-PRODUCTION / DISPOSABLE Supabase project. NEVER production.
# The global setup seeds it with a service-role key that bypasses RLS and
# writes rows; it refuses the known production project outright, and CI fails
# the job before the seeder runs.
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=
#
# The SAME non-production project's ANON key. The browser bundle under test is
# built with these, so the page the specs drive talks to exactly the project the
# fixtures seeded. Without it the bundle falls back to a placeholder host and
# every spec fails for the wrong reason.
#
# The service-role key must NEVER be given to the browser bundle — only this
# anon key, which is public by design.
E2E_SUPABASE_ANON_KEY=
